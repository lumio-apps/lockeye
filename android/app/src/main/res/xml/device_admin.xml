<?xml version="1.0" encoding="utf-8"?>
<!-- Lockeye asks for exactly one policy: to be told when an unlock attempt fails.
     It cannot lock, wipe, or read or change the phone's PIN. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <watch-login />
    </uses-policies>
</device-admin>
